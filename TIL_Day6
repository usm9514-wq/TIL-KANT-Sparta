## 부모 클래스를 호출하는 super()

#As you can see you can birng parent's call to discount product!

class Product:
    def __init__(self, name, price):
        self.name = name
        self.price = price

class DiscountProduct(Product):
    def __init__(self, name, price, discount_rate):
        super().__init__(name, price)
        self.discount_rate = discount_rate

product = DiscountProduct("노트북", 1000000, 10)

print(product.name)
print(product.price)
print(product.discount_rate)




# 우회 통로 함수

class Wallet:
    def __init__(self):
        self.__money = 1000  # 숨겨진 데이터

    def get_money(self):     # Getter: 값을 안전하게 꺼내서 전달합니다.
        return self.__money

    def set_money(self, amount):  # Setter: 올바른 값인지 조건 검증 후 변경합니다.
        if amount >= 0:
            self.__money = amount
        else:
            print("경고: 지갑의 돈은 음수가 될 수 없습니다.")

