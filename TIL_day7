CREATE TABLE customers (
    customer_id INT PRIMARY KEY,
    name VARCHAR(50) NOT NULL
);

CREATE TABLE reservations (
    reservation_id INT PRIMARY KEY,
    customer_id INT,
    room_number INT,
    FOREIGN KEY (customer_id)
        REFERENCES customers(customer_id)
);

