#map and filter

# 원시 정수형 데이터 리스트 정의
raw_scores = [2, 3, 4, 5, 6, 7]

# lambda와 map()을 엮어 리스트 모든 요소의 제곱 값을 한 줄로 추출하기
squared_scores = list(map(lambda n: n ** 2, raw_scores))
print(f"1단계 모든 요소 제곱 변환 결과: {squared_scores}")

# 변환된 데이터 중 20을 초과하는 알맹이 데이터만 filter()로 선별하여 추출하기
final_high_scores = list(filter(lambda score: score > 20, squared_scores))
print(f"2단계 기준 초과 최종 필터링 결과: {final_high_scores}")



