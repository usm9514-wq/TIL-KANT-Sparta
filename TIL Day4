# 전역 변수 선언
message = "저는 전역 변수입니다"

def test_scope():
    # 전역 변수와 이름이 똑같은 지역 변수 선언
    message = "저는 지역 변수입니다"
    print(f"[함수 내부 출력] {message}")  # 지역 변수가 우선 식별됨

test_scope()
print(f"[함수 외부 출력] {message}")  # 전역 변수 값은 오염되지 않고 유지됨


# Local      → 현재 함수 안
# Enclosing  → 나를 감싸는 함수 안
# Global     → 파일 전체
# Built-in   → 파이썬 기본 공간

name = "Global"

def outer():
    name = "Enclosing"

    def inner():
        name = "Local"
        print(name)

    inner()

outer()

## result will be just Local and it means you will get inner result first
