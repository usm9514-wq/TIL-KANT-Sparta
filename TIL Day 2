## dictionary
# 딕셔너리 선언 및 제어 예시
user_info = {"name": "Sparta", "age": 20}
user_info["age"] = 21       # 값 수정
user_info["role"] = "admin" # 새로운 키-값 쌍 추가
print(user_info)  # 출력: {'name': 'Sparta', 'age': 21, 'role': 'admin'}

## view method

menu = {"coffee": 4000, "tea": 4500}
print(menu.keys())   # 출력: dict_keys(['coffee', 'tea'])
print(menu.values()) # 출력: dict_values([4000, 4500])
print(menu.items())  # 출력: dict_items([('coffee', 4000), ('tea', 4500)])

price = menu.get("juice", 5000) # juice가 없으므로 기본값 5000을 반환
print(price)  # 출력: 5000


# 집합 선언과 중복 제거 확인
my_set = set([1, 2, 2, 3, 3, 3])
print(my_set)  # 출력: {1, 2, 3} (중복이 자동으로 제거됨)

set_a = {1, 2, 3}
set_b = {3, 4, 5}

print(set_a & set_b)  # 교집합 출력: {3}
print(set_a | set_b)  # 합집합 출력: {1, 2, 3, 4, 5}
print(set_a - set_b)  # 차집합 출력: {1, 2}
print(3 in set_a)     # 포함 여부 확인 결과 도출: True

