## 중첩 조건문(Nested if)의 작동 방식과 가독성 문제

is_logged_in = True
has_permission = True

# 1. 들여쓰기가 깊어지는 중첩 조건문 구조 (권장 X)
if is_logged_in:
    if has_permission:
        print("관리자 대시보드 진입")

# 2. 논리 연산자를 결합한 클린 코드 최적화 구조 (권장 O)
if is_logged_in and has_permission:
    print("관리자 대시보드 진입")



