 ## orderby 로 정렬 하는 방법

 -- 나이 기준 오름차순 정렬 (기본값)
SELECT *
FROM basic.theglory
ORDER BY 나이;

-- 나이 기준 내림차순 정렬
SELECT *
FROM basic.theglory
ORDER BY 나이 DESC;

-- 다중 정렬: 날짜 내림차순 → 나이 오름차순
SELECT 날짜, 이름, 성별, 나이, 직업
FROM basic.theglory
ORDER BY 1 DESC, 4 ASC;

### groupby 

-- GROUP BY 기본 구조
SELECT 기준열, 집계함수(열)
FROM 테이블명
WHERE 조건    -- 생략 가능
GROUP BY 기준열;

-- 예시: 성별 기준 집계
SELECT 성별,
       COUNT(*) AS cnt,
       AVG(나이) AS avg_age,
       MAX(나이) AS max_age,
       MIN(나이) AS min_age,
       SUM(나이) AS sum_age
FROM basic.theglory
GROUP BY 성별;

group by를 해야 그 각각의 분류 기준으로 묶여서 각 카트가 적용됨.


