## 반복을 중단하기 위한 종료 조건


# 조건식을 활용한 기본 while 문 구조
numbers = 1

while numbers <= 3:
    print(f"현재 숫자는 {numbers}입니다.")
    numbers += 1  # 종료 조건을 유도하기 위한 상태 변경


#터미널 강제 탈출
count = 3
while count > 0:
    print(count)
    count -= 1  # 명확한 종료 조건을 유도하여 False 도출 (누락 시 무한 루프)
