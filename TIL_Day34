def solution(costs, budget)
    max_cost = -1

    for i in range(len(costs)):
        for j in range(i +1, len(costs)):
            for k in range (j+1, len(costs)):
                total = costs[i] + costs[j] +costs[k]

                if total <= budget and total > max_cost:
                    max_cost = total
    return max_cost                



