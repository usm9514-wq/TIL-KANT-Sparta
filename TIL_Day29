



from collections import deque

network = {
    "A": ["B", "C"],
    "B": ["A", "D"],
    "C": ["A", "E"],
    "D": ["B"],
    "E": ["C"]
}

queue = deque(["A"])
visited = {"A"}

while queue:  # queue: []
    current = queue.popleft() # current = A
    print(current)

    for next_computer in network[current]:
        if next_computer not in visited:
            visited.add(next_computer)
            queue.append(next_computer)


