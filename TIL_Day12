### 3. pivot_table(): 데이터 재구성 요약


import pandas as pd

df = pd.DataFrame({
    "day": ["월요일", "월요일", "화요일", "화요일", "수요일"],
    "payment": ["카드", "계좌이체", "카드", "계좌이체", "카드"],
    "sales": [30000, 20000, 40000, 15000, 50000]
})

pivot = pd.pivot_table(
    df,
    index="day",
    columns="payment",
    values="sales",
    aggfunc="sum",
    fill_value=0
)

