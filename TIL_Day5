### 객체지향과 클래스, 인스턴스의 관계

절차 지향
product_name = "노트북"
stock = 10

def sell_product(current_stock):
    return current_stock - 1

stock = sell_product(stock)

print(f"{product_name} 재고: {stock}개")

객체지향
class Product:
    def __init__(self, name, stock):
        self.name = name
        self.stock = stock

    def sell(self):
        self.stock -= 1

product = Product("노트북", 10)
product.sell()

print(f"{product.name} 재고: {product.stock}개")


