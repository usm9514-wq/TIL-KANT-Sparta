import numpy as np

actual = np.array([20, 30, 40, 50])
# 실제값: 20, 30, 40, 50

pred_a = np.array([22, 29, 39, 52])
# 모델 A의 예측값
# 20 → 22
# 30 → 29
# 40 → 39
# 50 → 52

pred_b = np.array([25, 35, 45, 55])
# 모델 B의 예측값
# 20 → 25
# 30 → 35
# 40 → 45
# 50 → 55

residual_a = actual - pred_a
# 모델 A 잔차 = 실제값 - 예측값
# 20 - 22 = -2
# 30 - 29 =  1
# 40 - 39 =  1
# 50 - 52 = -2

residual_b = actual - pred_b
# 모델 B 잔차 = 실제값 - 예측값
# 20 - 25 = -5
# 30 - 35 = -5
# 40 - 45 = -5
# 50 - 55 = -5

sse_a = np.sum(residual_a ** 2)
# 모델 A 잔차 제곱합
# (-2)^2 + (1)^2 + (1)^2 + (-2)^2
# = 4 + 1 + 1 + 4
# = 10

sse_b = np.sum(residual_b ** 2)
# 모델 B 잔차 제곱합
# (-5)^2 + (-5)^2 + (-5)^2 + (-5)^2
# = 25 + 25 + 25 + 25
# = 100

print("모델 A 잔차 제곱합:", sse_a)
print("모델 B 잔차 제곱합:", sse_b)


